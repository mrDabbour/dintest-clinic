@baseUrl = http://localhost:5056


### ==========================================
### 1. GET all patients
### Expected: 200 OK
### ==========================================

GET {{baseUrl}}/api/patients
Accept: application/json


### ==========================================
### 2. GET one patient
### Expected: 200 OK if ID 4 exists
### ==========================================

GET {{baseUrl}}/api/patients/4
Accept: application/json


### ==========================================
### 3. CREATE patient
### Expected: 201 Created
### ==========================================

POST {{baseUrl}}/api/patients
Content-Type: application/json

{
  "firstName": "Daniel",
  "lastName": "Brown",
  "email": "daniel.brown@example.com",
  "phone": "0215551234"
}


### ==========================================
### 4. INVALID create
### Expected: 400 Bad Request
### ==========================================

POST {{baseUrl}}/api/patients
Content-Type: application/json

{
  "firstName": "",
  "lastName": "Brown",
  "email": "bad-email",
  "phone": "0215551234"
}


### ==========================================
### 5. UPDATE patient
### Expected: 204 No Content
### ==========================================

PUT {{baseUrl}}/api/patients/3
Content-Type: application/json

{
  "firstName": "Maher",
  "lastName": "Taylor",
  "email": "emma.taylor@example.com",
  "phone": "0225550199"
}


### ==========================================
### 6. GET updated patient
### Expected: 200 OK
### Verify the updated information
### ==========================================

GET {{baseUrl}}/api/patients/4
Accept: application/json


### ==========================================
### 7. DELETE non-existent patient
### Expected: 404 Not Found
### ==========================================

DELETE {{baseUrl}}/api/patients/999



### ==========================================
### 5. UPDATE patient
### Expected: 200 OK
### ==========================================

PUT {{baseUrl}}/api/patients/3
Content-Type: application/json

{
  "firstName": "Maher",
  "lastName": "Taylor",
  "email": "emma.taylor@example.com",
  "phone": "0225550199"
}